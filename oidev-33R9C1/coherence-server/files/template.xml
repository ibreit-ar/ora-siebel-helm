<?xml version="1.0"?>
    <cache-config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns="http://xmlns.oracle.com/coherence/coherence-cache-config"
                  xsi:schemalocation="http://xmlns.oracle.com/coherence/coherence-cache-config
       coherence-cache-config.xsd">

        <!-- Default settings for the cache -->
        <defaults>
            <!-- Specifies POF (Portable Object Format) for serialization -->
            <serializer>pof</serializer>
        </defaults>
        <!-- Maps cache names to caching schemes -->
        <caching-scheme-mapping>
            <cache-mapping>
                <!-- Defines the cache name -->
                <cache-name>siebelcache</cache-name>
                <!-- Maps this cache to the distributed caching scheme -->
                <scheme-name>distributed</scheme-name>
            </cache-mapping>
            <cache-mapping>
                <cache-name>OpenInt_*</cache-name>
                <scheme-name>oi-distributed-sessions</scheme-name>
            </cache-mapping>
            <cache-mapping>
                <cache-name>OpenintAtomic_*</cache-name>
                <scheme-name>oi-concurrent</scheme-name>
            </cache-mapping>
            <cache-mapping>
                <cache-name>OpenIntCollections_*</cache-name>
                <scheme-name>oi-distributed</scheme-name>
            </cache-mapping>
        </caching-scheme-mapping>
        <!-- Defines different caching schemes -->
        <caching-schemes>
            <!-- Distributed caching scheme configuration -->
            <distributed-scheme>
                <scheme-name>distributed</scheme-name>
                <service-name>DistributedCache</service-name>

                <!-- Specifies the local backing map storage strategy -->
                <backing-map-scheme>
                    <local-scheme>
                        <scheme-name>local</scheme-name>
                        <!-- Uses Least Frequently Used (LFU) eviction policy -->
                        <eviction-policy>LFU</eviction-policy>
                        <!-- Maximum cache memory usage (1000MB) -->
                        <high-units>1000M</high-units>
                        <!-- Measures cache size in bytes -->
                        <unit-calculator>BINARY</unit-calculator>
                    </local-scheme>
                </backing-map-scheme>
                <!-- Auto-starts this cache on startup -->
                <autostart>true</autostart>
            </distributed-scheme>
            <distributed-scheme>
                <scheme-name>oi-distributed-sessions</scheme-name>
                <service-name>DistributedCache</service-name>
                <backing-map-scheme>
                    <read-write-backing-map-scheme>
                        <internal-cache-scheme>
                            <local-scheme>
                                <high-units>0</high-units>
                                <expiry-delay>0</expiry-delay>
                            </local-scheme>
                        </internal-cache-scheme>
                        <listener>
                            <class-scheme>
                                <class-name>com.siebel.oi.cache.OpenIntEvictionListener</class-name>
                                <init-params>
                                    <init-param>
                                        <param-name>context</param-name>
                                        <param-value>{manager-context}</param-value>
                                    </init-param>
                                </init-params>
                            </class-scheme>
                        </listener>
                    </read-write-backing-map-scheme>
                </backing-map-scheme>
                <autostart>true</autostart>
            </distributed-scheme>
            <distributed-scheme>
                <scheme-name>oi-concurrent</scheme-name>
                <service-name>DistributedConcurrentCache</service-name>
                <backing-map-scheme>
                    <partitioned>true</partitioned>
                    <local-scheme>
                        <unit-calculator>BINARY</unit-calculator>
                    </local-scheme>
                </backing-map-scheme>
                <autostart>true</autostart>
            </distributed-scheme>
            <distributed-scheme>
                <scheme-name>oi-distributed</scheme-name>
                <service-name>DistributedCache</service-name>
                <backing-map-scheme>
                    <local-scheme/>
                </backing-map-scheme>
                <autostart>true</autostart>
            </distributed-scheme>

            <!-- Proxy caching scheme for remote access -->
           <!-- <proxy-scheme>
                <service-name>ExtendTcpProxyService</service-name>
                <acceptor-config>
                    <tcp-acceptor/>
                </acceptor-config>
                <autostart>true</autostart>
            </proxy-scheme>-->
            <proxy-scheme>
                <!-- Service name for the proxy -->
                <service-name>ExtendTcpProxyService</service-name>
                <acceptor-config>
                    <!-- TCP Acceptor for remote clients -->
                    <tcp-acceptor>
                        <socket-provider system-property="coherence.extend.socketprovider"/>
                    </tcp-acceptor>
                </acceptor-config>
                <!-- Auto-starts the proxy service -->
                <autostart>true</autostart>
            </proxy-scheme>

        </caching-schemes>
    </cache-config>